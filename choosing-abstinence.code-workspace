{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.sites-runtime": true,
      "**/.wrangler": true
    },
    "search.exclude": {
      "**/pnpm-lock.yaml": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start website",
        "type": "shell",
        "command": "pnpm dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Set up local database",
        "type": "shell",
        "command": "pnpm setup:local",
        "problemMatcher": []
      },
      {
        "label": "Check TypeScript",
        "type": "shell",
        "command": "pnpm typecheck",
        "problemMatcher": [
          "$tsc"
        ]
      }
    ]
  }
}
